# Private runtime settings. Substitute the installation root; never commit filled values.
NEWS_DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/news
NEWS_LLM_BASE_URL=http://MODEL_HOST:MODEL_PORT/v1
NEWS_LLM_MODEL=MODEL_NAME
NEWS_LLM_TIMEOUT_SECONDS=300
NEWS_PUBLIC_URL=https://OWNER.github.io/REPOSITORY/
NEWS_PUBLISH_CHECKOUT=/srv/daily-news/publisher
NEWS_DEPLOY_TIMEOUT_SECONDS=1200
DAGSTER_HOME=/srv/orchestrator/instance
GIT_SSH_COMMAND="ssh -i /srv/daily-news/keys/publisher -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes"
GIT_AUTHOR_NAME="Daily News"
GIT_AUTHOR_EMAIL=daily-news@users.noreply.github.com
GIT_COMMITTER_NAME="Daily News"
GIT_COMMITTER_EMAIL=daily-news@users.noreply.github.com
# Include the private scanner installation directory in PATH.
PATH=/srv/daily-news/bin:/usr/local/bin:/usr/bin:/bin
